<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – SecureGate</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-dark sg-nav">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">SecureGate</a>
            @if (ViewData["ShowNav"] is true)
            {
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <a class="text-white text-decoration-none" asp-controller="Home" asp-action="Index">My security</a>
                    <a class="text-white text-decoration-none" asp-controller="Home" asp-action="Monitoring">Monitoring</a>
                    <span class="text-white-50 small">Session expires in <b id="idle">15:00</b></span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                    </form>
                </div>
            }
        </div>
    </nav>
    <main class="container py-3">@RenderBody()</main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>