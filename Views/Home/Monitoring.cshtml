@{
    ViewData["Title"] = "Monitoring";
    ViewData["ShowNav"] = true;
}
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="sg-box sg-stat"><b>4</b><span>Accounts</span></div></div>
    <div class="col-6 col-md-3"><div class="sg-box sg-stat"><b>3</b><span>With MFA enrolled</span></div></div>
    <div class="col-6 col-md-3"><div class="sg-box sg-stat"><b>6</b><span>Failed verifications, last 24 h</span></div></div>
    <div class="col-6 col-md-3"><div class="sg-box sg-stat"><b>1</b><span>Locked accounts</span></div></div>
</div>

<div class="sg-box mb-3">
    <h2 class="h6">Users</h2>
    <div class="table-responsive">
        <table class="table table-sm small mb-0 align-middle">
            <thead><tr><th>User</th><th>Role</th><th>MFA</th><th>Codes left</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                <tr>
                    <td>zeed.jose</td>
                    <td>Administrator</td>
                    <td><span class="badge text-bg-success">enrolled</span></td>
                    <td>8</td>
                    <td>ok</td>
                    <td><button class="btn btn-outline-primary btn-sm" disabled>Unlock</button> <button class="btn btn-outline-danger btn-sm">Reset MFA</button></td>
                </tr>
                <tr>
                    <td>analyst1</td>
                    <td>Security Analyst</td>
                    <td><span class="badge text-bg-success">enrolled</span></td>
                    <td>10</td>
                    <td>ok</td>
                    <td><button class="btn btn-outline-primary btn-sm" disabled>Unlock</button> <button class="btn btn-outline-danger btn-sm">Reset MFA</button></td>
                </tr>
                <tr>
                    <td>student1</td>
                    <td>Standard User</td>
                    <td><span class="badge text-bg-warning">not enrolled</span></td>
                    <td>0</td>
                    <td><span class="badge text-bg-danger">locked</span></td>
                    <td><button class="btn btn-outline-primary btn-sm">Unlock</button> <button class="btn btn-outline-danger btn-sm">Reset MFA</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="sg-box">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
        <h2 class="h6 m-0 flex-grow-1">Audit trail</h2>
        <select class="form-select form-select-sm w-auto" aria-label="Filter events">
            <option>All events</option>
            <option>Failures and lockouts</option>
            <option>Sign-ins and sign-outs</option>
            <option>Security changes</option>
        </select>
        <button class="btn btn-outline-primary btn-sm">Export CSV</button>
    </div>
    <div class="table-responsive">
        <table class="table table-sm small mb-0">
            <thead><tr><th>Time</th><th>User</th><th>Event</th><th>Detail</th></tr></thead>
            <tbody>
                <tr><td>11/25/26 3:45 PM</td><td>student1</td><td><span class="badge text-bg-danger">lockout</span></td><td>15-minute lockout</td></tr>
                <tr><td>11/25/26 3:45 PM</td><td>student1</td><td><span class="badge text-bg-danger">totp fail</span></td><td>Invalid, expired, or reused code (5/5)</td></tr>
                <tr><td>11/25/26 3:41 PM</td><td>zeed.jose</td><td><span class="badge text-bg-success">login ok</span></td><td>Session created</td></tr>
                <tr><td>11/24/26 8:30 PM</td><td>analyst1</td><td><span class="badge text-bg-warning">recovery used</span></td><td>Old codes invalidated, email alert sent</td></tr>
            </tbody>
        </table>
    </div>
</div>