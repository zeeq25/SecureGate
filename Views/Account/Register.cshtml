@model SecureGate.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}
<div class="sg-card">
    <h1 class="h4">Create account</h1>
    <p class="sg-muted">You’ll set up an authenticator app next.</p>

    <form asp-controller="Account" asp-action="Register" method="post">
        <div asp-validation-summary="All" class="text-danger small"></div>
        <label asp-for="UserName" class="form-label mt-2">Username</label>
        <input asp-for="UserName" class="form-control" autocomplete="username" />
        <label asp-for="Email" class="form-label mt-3">Email</label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <label asp-for="Password" class="form-label mt-3">Password</label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <div class="form-text">At least 8 characters, with a number and an uppercase letter.</div>
        <label asp-for="ConfirmPassword" class="form-label mt-3">Confirm password</label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <button type="submit" class="btn btn-primary w-100 mt-4">Create account</button>
    </form>
    <p class="small mt-3 mb-0">Have an account? <a asp-controller="Account" asp-action="Login">Sign in</a></p>
</div>