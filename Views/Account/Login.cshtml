@model SecureGate.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="sg-card">
    <h1 class="h4">Sign in</h1>
    <p class="sg-muted">Password first, then a one-time code.</p>

    @if (TempData["Msg"] is string msg)
    {
        <div class="alert alert-success py-2 small">@msg</div>
    }

    <form asp-controller="Account" asp-action="Login" method="post">
        <div asp-validation-summary="All" class="text-danger small"></div>
        <label asp-for="UserName" class="form-label mt-2">Username</label>
        <input asp-for="UserName" class="form-control" autocomplete="username" />
        <label asp-for="Password" class="form-label mt-3">Password</label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
        <button type="submit" class="btn btn-primary w-100 mt-4">Continue</button>
    </form>
    <p class="small mt-3 mb-0">New here? <a asp-controller="Account" asp-action="Register">Create an account</a></p>
</div>